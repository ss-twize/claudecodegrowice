    {
      "parameters": {
        "jsCode": "const FIELD = 'last_message';\n\nfunction parseDate(value) {\n  if (!value) return null;\n  const d = new Date(String(value).trim());\n  return Number.isNaN(d.getTime()) ? null : d;\n}\n\nconst now = new Date();\n\nreturn items.map((item) => {\n  const j = item.json || {};\n  const dt = parseDate(j[FIELD]);\n\n  const sentFlag = String(j['50days_sent'] ?? '').trim().toLowerCase();\n  const canMessage = String(j.can_message ?? 'yes').trim().toLowerCase() !== 'no';\n  const blocked = String(j.blocked ?? 'no').trim().toLowerCase() === 'yes';\n  const hasChat = !!(j.tg_id || j.chat_id);\n\n  let daysSince = null;\n  let exactDays = null;\n  let inFuture = false;\n\n  if (dt) {\n    const diffMs = now.getTime() - dt.getTime();\n    inFuture = diffMs < 0;\n    exactDays = diffMs / 86400000;\n    daysSince = inFuture ? 0 : Math.floor(exactDays);\n  }\n\n  // Ровно 50-й день: окно [50, 51)\n  const isExactly50thDay = exactDays !== null && exactDays >= 50 && exactDays < 51;\n  const notSentYet = sentFlag !== 'sent';\n\n  item.json.days_since_last_message = daysSince;\n  item.json.last_message_in_future = inFuture;\n  item.json.should_send_50days = hasChat && isExactly50thDay && notSentYet && canMessage && !blocked;\n\n  return item;\n});\n"
      },
