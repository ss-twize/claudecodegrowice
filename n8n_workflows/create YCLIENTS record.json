      "name": "Проверка ответа YClients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [464, -160],
      "parameters": {
        "jsCode": "const resp = $input.item.json;\nif (!resp.success) {\n  const msg = resp.meta?.message || resp.data?.message || 'YClients отклонил запись';\n  return [{ json: { _book_error: true, error: msg, yclients_response: resp } }];\n}\nconst record = resp.data?.[0];\nif (!record?.record_id) {\n  return [{ json: { _book_error: true, error: 'YClients не вернул record_id', yclients_response: resp } }];\n}\nreturn [{ json: {\n  _book_ok: true,\n  record_id: record.record_id,\n  record_hash: record.record_hash,\n  yclients_client_id: String(record.client?.id ?? record.yclients_client_id ?? record.client_id ?? ''),\n  yclients_data: record\n}}];\n"
      }
    },
