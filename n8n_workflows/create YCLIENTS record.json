    {
      "id": "VALIDATE_INPUT",
      "name": "Проверка данных",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [48, 80],
      "parameters": {
        "jsCode": "const inp = $input.item.json;\nconst errors = [];\nif (!inp.phone || String(inp.phone).replace(/\\D/g,'').length < 10) {\n  errors.push('phone: отсутствует или некорректный номер телефона');\n}\nif (!inp.fullname || inp.fullname.trim().length < 2) {\n  errors.push('fullname: имя клиента обязательно');\n}\nif (!inp.services && !inp.service_id) {\n  errors.push('services: не указана услуга');\n}\nif (!inp.staff_id) {\n  errors.push('staff_id: не указан мастер');\n}\nif (!inp.datetime) {\n  errors.push('datetime: не указаны дата и время');\n} else {\n  const dt = new Date(inp.datetime);\n  if (isNaN(dt.getTime())) {\n    errors.push('datetime: некорректный формат даты');\n  } else if (dt < new Date()) {\n    errors.push('datetime: нельзя создать запись на прошедшее время');\n  }\n}\nif (errors.length > 0) {\n  return [{ json: { _validation_error: true, error: 'Некорректные данные: ' + errors.join('; '), errors } }];\n}\nconst phone = String(inp.phone).replace(/\\D/g,'');\nreturn [{ json: { ...inp, phone: phone.startsWith('8') ? '7' + phone.slice(1) : phone, _validation_ok: true } }];\n"
      }
    }
