    {
      "id": "VALIDATE_INPUT",
      "name": "Проверка данных",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        80
      ],
      "parameters": {
        "jsCode": "\n// Проверка обязательных полей перед созданием записи\nconst inp = $input.item.json;\nconst errors = [];\n\nif (!inp.phone || String(inp.phone).replace(/\\D/g,'').length < 10) {\n  errors.push('phone: отсутствует или некорректный номер телефона');\n}\nif (!inp.fullname || inp.fullname.trim().length < 2) {\n  errors.push('fullname: имя клиента обязательно');\n}\nif (!inp.services && !inp.service_id) {\n  errors.push('services: не указана услуга');\n}\nif (!inp.staff_id) {\n  errors.push('staff_id: не указан мастер');\n}\nif (!inp.datetime) {\n  errors.push('datetime: не указаны дата и время');\n} else {\n  const dt = new Date(inp.datetime);\n  if (isNaN(dt.getTime())) {\n    errors.push('datetime: некорректный формат даты');\n  } else if (dt < new Date()) {\n    errors.push('datetime: нельзя создать запись на прошедшее время');\n  }\n}\n\nif (errors.length > 0) {\n  return [{ json: { \n    _validation_error: true, \n    error: 'Некорректные данные: ' + errors.join('; '),\n    errors\n  }}];\n}\n\n// Нормализация телефона\nconst phone = String(inp.phone).replace(/\\D/g,'');\nreturn [{ json: { \n  ...inp, \n  phone: phone.startsWith('8') ? '7' + phone.slice(1) : phone,\n  _validation_ok: true\n}}];\n"
      }
    },
    {
      "id": "CHECK_BOOK_SUCCESS",
      "name": "Проверка ответа YClients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -160
      ],
      "parameters": {
        "jsCode": "\n// Проверяем что YClients вернул успех и record_id\nconst resp = $input.item.json;\n\n// YClients возвращает: { success: true/false, data: [...], meta: {message: '...'} }\nif (!resp.success) {\n  const msg = resp.meta?.message || resp.data?.message || 'YClients отклонил запись';\n  return [{ json: { \n    _book_error: true,\n    error: msg,\n    yclients_response: resp\n  }}];\n}\n\nconst record = resp.data?.[0];\nif (!record?.record_id) {\n  return [{ json: { \n    _book_error: true,\n    error: 'YClients не вернул record_id',\n    yclients_response: resp\n  }}];\n}\n\nreturn [{ json: {\n  _book_ok: true,\n  record_id: record.record_id,\n  record_hash: record.record_hash,\n  yclients_data: record\n}}];\n"
      }
    },
