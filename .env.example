# =============================================================
# СЕРВЕКС — шаблон переменных окружения
# Скопируй этот файл как .env.local и заполни реальными значениями
# .env.local НЕ коммитится в git
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # anon/public key (Supabase Dashboard → Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # service_role key — только серверный код, НИКОГДА не в NEXT_PUBLIC_

# --- Org ---
NEXT_PUBLIC_ORG_UID=11111111-1111-1111-1111-111111111111

# --- n8n ---
# Базовый URL инстанса n8n (без trailing slash)
NEXT_PUBLIC_N8N_WEBHOOK_BASE=https://n8n.YOUR_VPS.hstgr.cloud

# --- GREEN-API (серверный код только) ---
GREENAPI_PARTNER_TOKEN=                        # Партнёрский токен GREEN-API

# --- Webhook URLs (опционально — если не заполнены, берутся из таблицы webhooks в Supabase) ---
# NEXT_PUBLIC_WEBHOOK_RASSYLKA_ZAPUSTIT=
# NEXT_PUBLIC_WEBHOOK_KANAL_TOGGLE=
# NEXT_PUBLIC_WEBHOOK_SISTEMA_TOGGLE=
